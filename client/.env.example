VITE_API_URL=http://localhost:3000/api
# Su Vercel usare l'URL HTTPS del progetto API, sempre con /api finale.

# Google Identity Services — usato SOLO per la step-up authentication reale degli
# account Google su operazioni sensibili (reset transazioni, elimina account, export dati).
# Deve corrispondere allo stesso Client ID configurato lato server (GOOGLE_CLIENT_ID).
# È un identificativo pubblico, non un secret: non contiene GOOGLE_CLIENT_SECRET.
VITE_GOOGLE_CLIENT_ID=

# Client ID OAuth iOS pubblico. Deve essere associato al Bundle ID dell’app.
VITE_GOOGLE_IOS_CLIENT_ID=

# Servizio Apple pubblico e URL HTTPS registrato nel Services ID.
VITE_APPLE_SERVICE_ID=
VITE_APPLE_REDIRECT_URI=

# Contatti pubblici WALLT (assistenza, privacy e termini).
VITE_SUPPORT_EMAIL=support@pec.wallt.it
VITE_COMPANY_EMAIL=support@pec.wallt.it
VITE_LEGAL_EMAIL=support@pec.wallt.it

# MONITORAGGIO ERRORI (Sentry) — OPZIONALE
# Senza questa variabile l'app funziona identica e gli errori restano in
# console: non viene nemmeno caricato il pacchetto. Attivo solo nelle build di
# produzione, mai in sviluppo.
# Il DSN è un identificativo pubblico (finisce nel bundle), non un secret.
# L'origin del DSN viene aggiunto automaticamente a connect-src nella CSP:
# vedi vite.config.js, senza quella source i report verrebbero bloccati.
# Prima di inviare, ogni report viene ripulito da importi, saldi, categorie,
# descrizioni, email e token (vedi src/utils/monitoraggio.js).
VITE_SENTRY_DSN=
