{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/ricorrenti",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/notifiche",
      "schedule": "0 19 * * *"
    }
  ]
}
