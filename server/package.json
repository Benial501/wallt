{
  "name": "server",
  "version": "0.1.0-alpha",
  "description": "WALLT API Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:production": "NODE_ENV=migration sequelize-cli db:migrate",
    "migrate:production:status": "NODE_ENV=migration sequelize-cli db:migrate:status",
    "migrate:production:undo": "NODE_ENV=migration sequelize-cli db:migrate:undo",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:status": "sequelize-cli db:migrate:status",
    "test": "NODE_ENV=test jest --runInBand",
    "test:unit": "NODE_ENV=test jest --config jest.unit.config.js --runInBand",
    "test:watch": "NODE_ENV=test jest --watch --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.5.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "resend": "^6.17.2",
    "sequelize": "^6.37.8",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "sinon": "^22.0.0",
    "supertest": "^7.2.2"
  }
}
